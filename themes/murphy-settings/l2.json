{
  "format": 1,
  "id": "murphy-settings-l2",
  "screen": [
    480,
    800
  ],
  "bindings": {
    "$page.title": 70,
    "$page.rows": 72,
    "$item.value": 74,
    "$item.selected": 75,
    "$item.is_section": 76,
    "$item.is_row": 77,
    "$item.navigates": 78
  },
  "actions": {
    "open_hub_card": 40,
    "activate_setting": 41
  },
  "nodes": [
    {
      "type": "clear",
      "color": "white"
    },
    {
      "type": "text",
      "rect": [
        24,
        15,
        200,
        16
      ],
      "text": "Murphy M4",
      "font": "ui_12_regular",
      "align": "left"
    },
    {
      "type": "battery",
      "rect": [
        431,
        18,
        22,
        10
      ],
      "binding": "$system.battery"
    },
    {
      "type": "text",
      "rect": [
        24,
        48,
        300,
        32
      ],
      "text": "$page.title",
      "font": "ui_18_bold",
      "align": "left",
      "ellipsis": true
    },
    {
      "type": "line",
      "x": 8,
      "y": 91,
      "x2": 472,
      "y2": 91,
      "width": 2,
      "color": "black"
    },
    {
      "type": "round_rect",
      "rect": [
        8,
        130,
        464,
        522
      ],
      "r": 11,
      "stroke": 2
    },
    {
      "type": "repeat",
      "source": "$page.rows",
      "limit": 9,
      "x": 8,
      "y": 130,
      "item_width": 464,
      "item_height": 58,
      "gap": 0,
      "direction": "vertical",
      "action": "activate_setting",
      "action_arg": "$item.id",
      "children": [
        {
          "type": "round_rect",
          "rect": [
            2,
            4,
            460,
            50
          ],
          "r": 0,
          "stroke": 1,
          "fill": true,
          "visible_if": "$item.selected"
        },
        {
          "type": "text",
          "rect": [
            18,
            16,
            200,
            22
          ],
          "text": "$item.title",
          "font": "ui_18_regular",
          "align": "left",
          "ellipsis": true,
          "visible_if": "$item.is_row"
        },
        {
          "type": "text",
          "rect": [
            270,
            20,
            174,
            18
          ],
          "text": "$item.value",
          "font": "ui_14_regular",
          "align": "right",
          "ellipsis": true,
          "visible_if": "$item.is_row"
        },
        {
          "type": "line",
          "x": 447,
          "y": 24,
          "x2": 453,
          "y2": 30,
          "width": 3,
          "color": "black",
          "visible_if": "$item.navigates"
        },
        {
          "type": "line",
          "x": 453,
          "y": 30,
          "x2": 447,
          "y2": 36,
          "width": 3,
          "color": "black",
          "visible_if": "$item.navigates"
        },
        {
          "type": "line",
          "x": 18,
          "y": 57,
          "x2": 464,
          "y2": 57,
          "width": 2,
          "color": "black",
          "visible_if": "$item.is_row"
        }
      ]
    }
  ]
}
