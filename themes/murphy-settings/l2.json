{
  "format": 1,
  "id": "murphy-settings-l2",
  "screen": [480, 800],
  "bindings": {
    "$page.title": 70,
    "$page.rows": 72,
    "$item.value": 74,
    "$item.selected": 75,
    "$item.is_section": 76,
    "$item.is_row": 77
  },
  "actions": {
    "open_hub_card": 40,
    "activate_setting": 41
  },
  "nodes": [
    {"type": "clear", "color": "white"},
    {"type": "text", "rect": [24, 24, 280, 24], "text": "$page.title", "font": "ui_16_bold", "align": "left", "ellipsis": true},
    {"type": "battery", "rect": [432, 24, 24, 12], "binding": "$system.battery"},
    {"type": "line", "x": 23, "y": 52, "x2": 456, "y2": 52, "width": 1, "color": "black"},
    {"type": "repeat", "source": "$page.rows", "limit": 8, "x": 24, "y": 68, "item_width": 432, "item_height": 80, "gap": 4, "direction": "vertical", "action": "activate_setting", "action_arg": "$item.id", "children": [
      {"type": "round_rect", "rect": [0, 12, 4, 56], "r": 0, "fill": true, "visible_if": "$item.selected"},
      {"type": "text", "rect": [20, 28, 260, 24], "text": "$item.title", "font": "ui_16_regular", "align": "left", "ellipsis": true, "visible_if": "$item.is_row"},
      {"type": "text", "rect": [20, 32, 400, 20], "text": "$item.title", "font": "ui_14_regular", "align": "left", "ellipsis": true, "visible_if": "$item.is_section"},
      {"type": "text", "rect": [280, 30, 140, 20], "text": "$item.value", "font": "ui_14_regular", "align": "right", "ellipsis": true, "visible_if": "$item.is_row"}
    ]}
  ]
}
