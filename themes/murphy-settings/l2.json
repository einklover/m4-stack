{
  "format": 1,
  "id": "murphy-settings-l2",
  "screen": [480, 800],
  "bindings": {
    "$page.title": 70,
    "$page.rows": 72,
    "$item.value": 74,
    "$item.selected": 75,
    "$item.is_section": 76,
    "$item.is_row": 77,
    "$item.navigates": 78
  },
  "actions": {
    "open_hub_card": 40,
    "activate_setting": 41
  },
  "nodes": [
    {"type": "clear", "color": "white"},
    {"type": "text", "rect": [24, 15, 200, 16], "text": "Murphy M4", "font": "ui_12_regular", "align": "left"},
    {"type": "battery", "rect": [431, 18, 22, 10], "binding": "$system.battery"},
    {"type": "text", "rect": [24, 48, 300, 32], "text": "$page.title", "font": "ui_24_bold", "align": "left", "ellipsis": true},
    {"type": "line", "x": 22, "y": 91, "x2": 458, "y2": 91, "width": 1, "color": "black"},
    {"type": "repeat", "source": "$page.rows", "limit": 9, "x": 22, "y": 126, "item_width": 436, "item_height": 52, "gap": 0, "direction": "vertical", "action": "activate_setting", "action_arg": "$item.id", "children": [
      {"type": "round_rect", "rect": [4, 4, 428, 44], "r": 9, "stroke": 1, "fill": true, "visible_if": "$item.selected"},
      {"type": "text", "rect": [18, 18, 200, 20], "text": "$item.title", "font": "ui_18_regular", "align": "left", "ellipsis": true, "visible_if": "$item.is_row"},
      {"type": "text", "rect": [222, 20, 174, 18], "text": "$item.value", "font": "ui_14_regular", "align": "right", "ellipsis": true, "visible_if": "$item.is_row"},
      {"type": "line", "x": 18, "y": 51, "x2": 424, "y2": 51, "width": 1, "color": "black", "visible_if": "$item.is_row"},
      {"type": "line", "x": 418, "y": 21, "x2": 423, "y2": 26, "width": 2, "color": "black", "visible_if": "$item.navigates"},
      {"type": "line", "x": 423, "y": 26, "x2": 418, "y2": 31, "width": 2, "color": "black", "visible_if": "$item.navigates"}
    ]}
  ]
}
