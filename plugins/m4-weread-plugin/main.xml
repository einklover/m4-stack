<?xml version="1.0"?>
<m4ui version="1" start="home" theme="wap" fullscreen="true">
  <screen id="home" title="微信读书" class="compact">
    <text text="继续阅读" class="hero inset" />
    <text text="@page.status" class="meta inset" />
    <divider class="hairline inset" />
    <list
      id="books"
      source="provider.books"
      titleField="title"
      subtitleField="author"
      valueField="progress"
      onActivate="provider.openBook"
      class="inset compact"
      pageSize="8" />
    <buttons
      back="返回"
      primary="详情"
      left="登录"
      right="同步"
      onBack="system.back"
      onPrimary="provider.openSelected"
      onLeft="provider.login"
      onRight="provider.refresh" />
  </screen>
</m4ui>
